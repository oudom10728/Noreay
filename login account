<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Account</title>
  <style>
    * 
     {
      box-sizing: border-box;
      margin: 0px;
      padding: 0px;
    }
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color:#ffffff;
      background-color: darkblue;
    }
    form {
      width: 400px;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0px 0px 10px rgba(147, 1, 1, 0.1);
      color: black;
      background-color: #ffffff;
    }
    .formcontroller {
      display: flex;
      flex-direction: column;
      margin-bottom: 20px;
    }
    label {
      margin-bottom: 10px;
    }
    input {
      padding: 10px;
      border-radius: 5px;
      border: 1px solid #ccc;
    }
    button {
      padding: 10px;
      border-radius: 5px;
      border: none;
      background-color: #0befa7;
      color: #ffffff;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <form action="">
    <div class="formcontroller">
      <label for="username">Username</label>
      <input
        type="text"
        id="username"
        placeholder="Username"
        name="username"
      />
    </div>
    <div class="formcontroller">
      <label for="password">Password</label>
      <input type="password" placeholder="Password" id="password" />
    </div>
    <div class="formcontroller">
      <button type="submit">LOGIN</button>
    </div>
  </form>
</body>
</html>
